DATABASE_URL="postgresql://aduanai:aduanai123@localhost:5433/aduanai?schema=public"
# Pool PostgreSQL: máximo de conexiones y tiempos de espera en milisegundos
PG_POOL_MAX=10
PG_CONNECT_TIMEOUT_MS=8000
PG_IDLE_TIMEOUT_MS=60000
PG_STATEMENT_TIMEOUT_MS=30000
PG_QUERY_TIMEOUT_MS=35000
# Health: espera máxima de la consulta a la DB antes de reportar estado degradado (milisegundos)
HEALTH_DB_TIMEOUT_MS=2000
# Bloqueo de IP: vigencia del cache y timeout máximo de consulta a la DB (milisegundos)
IPBLOCK_CACHE_TTL_MS=45000
IPBLOCK_DB_TIMEOUT_MS=800
ANTHROPIC_API_KEY="sk-ant-..."
# LLM: timeout base de Anthropic, reintentos del SDK y timeout por llamada interactiva (milisegundos)
ANTHROPIC_TIMEOUT_MS=120000
ANTHROPIC_MAX_RETRIES=2
LLM_TIMEOUT_MS=60000
# Embeddings Voyage/OpenAI: timeout por intento y presupuesto total por llamada (milisegundos)
VOYAGE_TIMEOUT_MS=10000
VOYAGE_TOTAL_TIMEOUT_MS=30000
JWT_SECRET="change-this-to-a-random-string"
CLIENT_URL="http://localhost:5173"
PORT=3001
YCLOUD_API_KEY=""
YCLOUD_FROM_NUMBER=""
WHATSAPP_VERIFY_TOKEN="aduanai-webhook-verify-2026"
