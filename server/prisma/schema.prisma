// ============================================
// BACKUPS, RESTORES E INCIDENTES — continuidad enterprise
// ============================================

model BackupRecord {
  id              String   @id @default(cuid())
  type            String   // "daily" | "weekly" | "monthly" | "manual"
  status          String   // "running" | "success" | "failed" | "verifying"

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  durationMs  Int?

  storageProvider String  // "local" | "r2" | "s3"
  storageUrl      String?
  storageKey      String?

  sizeBytes   BigInt?
  recordCount Int?

  checksumSHA256 String?
  encrypted      Boolean @default(true)

  errorMessage String?

  retentionDays Int
  expiresAt     DateTime?

  triggeredBy String? // userId si manual, "cron" si automático

  restores RestoreLog[]

  @@index([type, startedAt])
  @@index([status])
  @@index([expiresAt])
  @@map("backup_records")
}

model RestoreLog {
  id String @id @default(cuid())

  backupId String
  backup   BackupRecord @relation(fields: [backupId], references: [id])

  type        String   // "full" | "partial" | "test"
  startedAt   DateTime @default(now())
  completedAt DateTime?
  status      String

  scope           Json?
  recordsRestored Int?

  triggeredBy String
  reason      String?

  errorMessage String?

  @@index([backupId])
  @@index([startedAt])
  @@map("restore_logs")
}

model SystemIncident {
  id String @id @default(cuid())

  title    String
  severity String // "minor" | "major" | "critical"
  status   String // "investigating" | "identified" | "monitoring" | "resolved"

  startedAt   DateTime  @default(now())
  resolvedAt  DateTime?

  components String[] // ["api", "database", "ai", "frontend", "email", "storage"]

  description String
  updates     Json[]    // [{ ts, message, status }]

  affectedUsers Int?
  rootCause     String?
  resolution    String?

  publicVisible Boolean @default(true)

  createdBy String?
  updatedAt DateTime @updatedAt

  @@index([status, startedAt])
  @@index([publicVisible, startedAt])
  @@map("system_incidents")
}

model IncidentSubscription {
  id        String   @id @default(cuid())
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  unsubscribedAt DateTime?

  @@index([active])
  @@map("incident_subscriptions")
}

// ============================================
// VERIFICACIÓN PROFESIONAL — agentes/apoderados/importadores
