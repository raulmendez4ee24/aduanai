// ============================================
// SECURITY
// ============================================

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String
  userAgent String?
  success   Boolean
  reason    String?
  createdAt DateTime @default(now())

  @@index([email])
  @@index([ip])
  @@index([createdAt])
  @@map("login_attempts")
}

model TokenBlacklist {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([expiresAt])
  @@map("token_blacklist")
}

// ============================================
// BOM — Productos terminados y materia prima IMMEX
// ============================================

model Product {
  id           String   @id @default(cuid())
  tenantId     String
  productCode  String   // SKU del cliente
  description  String
  fractionCode String?  // Fracción arancelaria si aplica (8 dígitos sin puntos)
  unit         String   // Pza, Kg, m, etc.
  isFinished   Boolean  @default(false) // false = materia prima, true = producto terminado
  active       Boolean  @default(true)
  isDemoData   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Si es producto terminado: componentes que lo conforman
  components ProductComponent[] @relation("ProductBOM")
  // Si es materia prima: en qué productos terminados se usa
  usedIn     ProductComponent[] @relation("ComponentOfBOM")
  assemblies Assembly[]

  @@unique([tenantId, productCode])
  @@index([tenantId])
  @@index([isFinished])
  @@index([fractionCode])
  @@index([isDemoData])
  @@map("products")
}

model ProductComponent {
  id           String   @id @default(cuid())
  productId    String   // Producto terminado
  product      Product  @relation("ProductBOM", fields: [productId], references: [id], onDelete: Cascade)
  componentId  String   // Materia prima / sub-ensamble
  component    Product  @relation("ComponentOfBOM", fields: [componentId], references: [id])
  quantity     Float    // Unidades de componente requeridas por 1 unidad de producto terminado
  unit         String
  scrapPercent Float    @default(0) // Merma esperada (%)
  notes        String?
  createdAt    DateTime @default(now())

  @@unique([productId, componentId])
  @@index([productId])
  @@index([componentId])
  @@map("product_components")
}

model Assembly {
  id           String   @id @default(cuid())
  tenantId     String
  productId    String   // Producto terminado ensamblado
  product      Product  @relation(fields: [productId], references: [id])
  quantity     Float    // Cantidad ensamblada
  assemblyDate DateTime
  reference    String?  // Orden de producción / referencia interna
  notes        String?
  isDemoData   Boolean  @default(false)
  createdAt    DateTime @default(now())

  consumptions AssemblyConsumption[]

  @@index([tenantId])
  @@index([productId])
  @@index([assemblyDate])
  @@index([isDemoData])
  @@map("assemblies")
}

model AssemblyConsumption {
  id                String   @id @default(cuid())
  assemblyId        String
  assembly          Assembly @relation(fields: [assemblyId], references: [id], onDelete: Cascade)
  componentId       String   // Producto materia prima consumido
  componentCode     String   // SKU snapshot
  fractionCode      String?  // Fracción snapshot
  quantityRequired  Float    // Por BOM, sin merma
  quantityWithScrap Float    // Real consumido = required × (1 + scrapPercent/100)
  unit              String
  // Trazabilidad: IDs de TemporaryImport descontados FIFO
  importIds         String[]
  createdAt         DateTime @default(now())

  @@index([assemblyId])
  @@index([componentId])
  @@map("assembly_consumptions")
}

// ============================================
// CUOTAS COMPENSATORIAS (antidumping)
// ============================================

model AntidumpingDuty {
  id              String    @id @default(cuid())
  fractionCode    String // 8 dígitos sin puntos
  countryOfOrigin String // ISO-2 normalizado (CN, US, etc.)
  rate            Float // % aplicable a base CIF (sobre valor en aduana)
  type            String    @default("definitiva") // "definitiva" | "provisional"
  decree          String? // referencia DOF, ej. "DOF-2024-03-15"
  publishDate     DateTime?
  effectiveDate   DateTime?
  expiryDate      DateTime?
  notes           String?
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([fractionCode, countryOfOrigin], name: "antidumping_fraction_country")
  @@index([fractionCode])
  @@index([countryOfOrigin])
  @@index([active])
  @@map("antidumping_duties")
}

// ============================================
// REGULACIONES POR FRACCIÓN — NOMs / RRNA / Padrones
// ============================================

model FractionRegulation {
  id           String   @id @default(cuid())
  fractionCode String // 8 dígitos sin puntos; usar prefijo (ej "8485") para regla por capítulo/partida
  matchType    String   @default("exact") // "exact" | "prefix"
  type         String // "NOM" | "RRNA" | "padron_sectorial" | "permiso_previo"
  authority    String // "SE" | "COFEPRIS" | "SEMARNAT" | "SADER" | "SENASICA" | "SAT"
  code         String // ej. "NOM-004-SE-2006" o "Sector 11 — Hierro y acero"
  description  String
  required     Boolean  @default(true)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([fractionCode])
  @@index([type])
  @@index([active])
  @@map("fraction_regulations")
}

// ============================================
// DEMO DATA — Fixture registry for sales demos
// ============================================

model DemoData {
  id        String   @id @default(cuid())
  category  String // 'inventory' | 'discharges' | 'fiscal' | 'guarantees' | 'certification'
  // | 'classifications' | 'quotes' | 'operations' | 'mve' | 'logistics' | 'alerts'
  data      Json // Array of records or single record blob to materialize
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([category])
  @@index([active])
  @@map("demo_data")
}
