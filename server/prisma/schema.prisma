// ============================================
// PRECEDENTES LEGALES — TFJA, SCJN, criterios SAT, OMA
// ============================================

model LegalPrecedent {
  id            String   @id @default(cuid())
  type          String   // "TFJA" | "SCJN" | "CRITERIO_SAT" | "CONSULTA_SAT" | "OMA" | "RESOLUCION_UPCI"
  reference     String   // ej "Tesis V-P-2aS-XX/2023" o "Criterio Normativo 14/CFF/N"
  title         String

  fractionCodes String[] // 8 dígitos sin puntos; vacío = aplica genéricamente
  chapterCodes  String[] // 2 dígitos; para búsqueda por capítulo
  topic         String   // "subvaluación" | "reclasificación" | "origen" | "noms" | "vinculación" | "antidumping" | "valor_aduanero" | "uso_destinado"

  summary       String   // resumen del caso
  ruling        String   // determinación / sentido del fallo
  reasoning     String   // razonamiento legal
  applicability String?  // "cuándo aplica" — guía práctica para clasificadores

  yearPublished Int
  isVigente     Boolean  @default(true)
  litigated     Boolean  @default(false)  // marca casos con litigio activo / controversiales

  source        String?  // URL o referencia oficial DOF/TFJA
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([type])
  @@index([topic])
  @@index([yearPublished])
  @@index([isVigente])
  @@index([litigated])
  @@map("legal_precedents")
}

// ============================================
// TRAZABILIDAD VERSIONAL — auditoría SAT
// ============================================

model VersionSnapshot {
  id            String    @id @default(cuid())
  type          String    // "TIGIE" | "LIGIE" | "RGCE" | "DOF" | "TMEC" | "ANEXO_22" | "ACUERDO_NOMs"
  version       String    // "2026-01-01" o "post-reforma-29dic2025" o "v4.7"
  publishDate   DateTime
  effectiveDate DateTime
  expiryDate    DateTime?
  contentHash   String    // SHA-256 del contenido normativo
  source        String?   // URL del DOF / referencia oficial
  notes         String?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())

  @@unique([type, version])
  @@index([type, active])
  @@index([effectiveDate])
  @@map("version_snapshots")
}

model ClassificationConsult {
  id               String   @id @default(cuid())
  classificationId String?  // referencia opcional al Classification.id
  tenantId         String?  // para reportes por tenant
  userId           String?

  inputHash         String  // SHA-256 de los inputs canonicalizados
  inputs            Json    // descripción, contexto, país, valor, sector, etc.

  outputHash        String  // SHA-256 del JSON de resultado
  outputs           Json    // resultado completo del clasificador

  // Versiones consultadas en el momento
  tigieVersion      String
  ligieVersion      String
  rgceVersion       String?
  acuerdoNomsVersion String?
  tmecVersion       String?

  // Knowledge base que entró al prompt
  knowledgeBaseHash String  // SHA-256 de IDs+contenido de KB usado
  knowledgeUsed     Json    // [{ id, title, type, fractionCode? }]

  // Modelo IA
  modelUsed         String  // "claude-sonnet-4-20250514" | "gemini-2.0-flash-exp" | ...
  modelProvider     String  // "anthropic" | "gemini"

  // Hash combinado para verificación pública
  consultHash       String  @unique  // SHA-256 final

  consultedAt       DateTime @default(now())

  @@index([classificationId])
  @@index([tenantId])
  @@index([consultHash])
  @@index([consultedAt])
  @@index([tigieVersion])
  @@map("classification_consults")
}

// ============================================
// EXCEPCIONES DE NOMs — Anexo 2.4.1 Acuerdo NOMs
// ============================================

model NOMException {
  id             String   @id @default(cuid())
  nomCode        String?  // "NOM-008-SCFI-2002"; null = aplica a cualquier NOM (excepción genérica)
  nomScope       String?  // "ALL" | "INFO" (NOM informativa) | "SEG" (NOM seguridad) — para reglas amplias
  exceptionCode  String   // "Anexo 2.4.1 fracción II"
  fraction       String   // "I", "II", "III"... — número de fracción del anexo
  description    String
  conditions     Json     // { immex?: bool, samples?: bool, industrial?: bool, automotive?: bool, etc. }
  requiredDoc    String?  // "Carta de No Comercialización" | "Pedimento IMMEX" | "Carta industrial"
  legalBasis     String?  // referencia legal — Acuerdo de NOMs, fecha DOF
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([nomCode])
  @@index([nomScope])
  @@index([active])
  @@map("nom_exceptions")
}

// ============================================
// REGLAS DE ORIGEN — TMEC, TLCUEM, CPTPP
// ============================================

model OriginRule {
  id              String   @id @default(cuid())
  fractionCode    String   // 8 dígitos sin puntos; o prefijo (capítulo/partida) con matchType=prefix
  matchType       String   @default("exact") // "exact" | "prefix"
  agreement       String   // "TMEC" | "TLCUEM" | "CPTPP" | "ALADI" | "AAP"
  ruleType        String   // "wholly_obtained" | "tariff_shift" | "rvc" | "specific_process" | "combined"
  description     String
  rvcRequired     Float?   // % requerido si aplica RVC
  rvcMethod       String?  // "transaction_value" | "net_cost" | "either" | "build_up" | "build_down"
  tariffShift     String?  // descripción del cambio (ej. "cambio a partida 8703 desde cualquier otro capítulo")
  tariffShiftCode String?  // "CC" (cambio capítulo) | "CTH" (cambio partida) | "CTSH" (cambio subpartida)
  specificProcess String?  // proceso productivo requerido (ej. "fundido y vaciado en territorio")
  annex           String?  // "4-B" automotriz, etc.

  // Automotriz Anexo 4-B
  isAutomotive          Boolean @default(false)
  autoCategory          String? // "vehicle" | "core_part" | "principal_part" | "complementary_part"
  laborValueContent     Float?  // % LVC requerido
  steelAluminumPercent  Float?  // % acero/aluminio NA requerido

  // Textiles
  textileRule String? // "yarn_forward" | "fiber_forward" | "fabric_forward"

  notes           String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([fractionCode, agreement])
  @@index([agreement])
  @@index([active])
  @@index([isAutomotive])
  @@map("origin_rules")
}

model OriginAnalysis {
  id           String  @id @default(cuid())
  fractionCode String
  agreement   String   // "TMEC", etc.
  productDescription String?

  // Inputs declarados
  productValue       Float
  originatingValue   Float   // valor de materiales originarios
  nonOriginatingValue Float
  originatingMaterials    Json?  // [{ description, value, fraction, origin }]
  nonOriginatingMaterials Json?
  laborCost          Float?
  highWageLaborCost  Float?  // pagado >$16 USD/hr (LVC)
  overheadCost       Float?
  profit             Float?
  packagingCost      Float?
  royalties          Float?
  rvcMethod          String  @default("transaction_value")

  // Steel/Aluminum (automotriz)
  totalSteelAluminumValue       Float?
  northAmericanSteelAluminumValue Float?

  // Resultados RVC por método
  rvcCalculated      Float?  // legacy — método elegido
  rvcTransactionValue Float?
  rvcNetCost         Float?
  rvcBuildUp         Float?
  rvcBuildDown       Float?

  // Tariff shift
  tariffShiftCompliance Boolean?
  tariffShiftDetails    Json?

  // Automotriz checks
  laborValueContentPct  Float?
  lvcCompliance         Boolean?
  steelAluminumNAPct    Float?
  saCompliance          Boolean?

  // Veredicto
  ruleApplied      String?
  qualifies        Boolean
  qualifyingMethod String?  // "transaction_value" | "net_cost" | "build_up" | "build_down" | "wholly_obtained" | "tariff_shift" | "specific_process"
  reason           String
  reasons          String[]
  recommendations  Json?

  consultHash String?

  createdAt DateTime @default(now())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  userId   String
  user     User   @relation(fields: [userId], references: [id])

  certificates OriginCertificate[]

  @@index([tenantId])
  @@index([fractionCode])
  @@index([agreement])
  @@index([createdAt])
  @@map("origin_analyses")
}

model OriginCertificate {
  id String @id @default(cuid())

  certificateNumber String @unique

  fractionCode       String
  productDescription String

  exporterName    String
  exporterAddress String?
  exporterTaxId   String?

  importerName    String?
  importerAddress String?
  importerTaxId   String?

  producerName    String?
  producerAddress String?
  producerTaxId   String?

  originCountry       String  // "MX" | "US" | "CA"
  preferenceCriterion String  // "A" | "B" | "C" | "D" | "E"

  blanketPeriodFrom DateTime?
  blanketPeriodTo   DateTime?

  signedDate    DateTime
  signedBy      String
  signedByRole  String

  originAnalysisId String?
  analysis         OriginAnalysis? @relation(fields: [originAnalysisId], references: [id])

  status   String  @default("issued") // "draft" | "issued" | "active" | "expired" | "revoked"
  pdfUrl   String?
  contentHash String?

  tenantId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([fractionCode])
  @@index([status])
  @@index([originCountry])
  @@map("origin_certificates")
}

