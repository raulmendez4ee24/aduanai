// ============================================
// TIMESTAMP PROOFS — anclaje a blockchain Bitcoin (OpenTimestamps)
// ============================================

model TimestampProof {
  id String @id @default(cuid())

  resourceType String // "audit_log" | "classification" | "quote" | "pedimento" | "certificate" | "consult"
  resourceId   String
  contentHash  String // SHA-256 hex del contenido

  otsProof    Bytes
  otsProofHex String? // hex para debugging y descarga

  bitcoinBlock     Int?
  bitcoinTxId      String?
  bitcoinTimestamp DateTime?

  status String @default("pending") // "pending" | "submitted" | "confirmed" | "verified" | "failed"

  submittedAt   DateTime  @default(now())
  confirmedAt   DateTime?
  lastCheckedAt DateTime?

  verificationCount Int       @default(0)
  lastVerifiedAt    DateTime?

  errorMessage String?

  // Calendar URL de donde proviene el proof inicial
  calendarUrl String?

  @@index([resourceType, resourceId])
  @@index([status, submittedAt])
  @@index([contentHash])
  @@map("timestamp_proofs")
}

// ============================================
// SECURITY EVENTS — auditoría de abuso y bloqueos
// ============================================

model SecurityEvent {
  id        String   @id @default(cuid())
  type      String   // "failed_login" | "rate_limit_hit" | "ip_blocked" | "user_locked" | "suspicious_pattern" | "honeypot_triggered" | "form_too_fast"
  severity  String   @default("medium") // "low" | "medium" | "high" | "critical"
  ip        String
  userId    String?
  email     String?  // para failed_login antes de tener userId
  endpoint  String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@index([type, createdAt])
  @@index([severity])
  @@index([userId])
  @@map("security_events")
}

model BlockedIP {
  id        String    @id @default(cuid())
  ip        String    @unique
  reason    String
  expiresAt DateTime  // cuando termina el bloqueo
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  unblockedAt DateTime?
  unblockedBy String?

  @@index([ip, active])
  @@index([expiresAt])
  @@map("blocked_ips")
}

// ============================================
// LOGGING Y MONITOREO — observabilidad enterprise
// ============================================

model SystemLog {
