  entityId String?
  action   String?

  metadata  Json?
  userAgent String?
  ip        String?

  @@index([level, timestamp])
  @@index([tenantId, timestamp])
  @@index([endpoint, timestamp])
  @@index([requestId])
  @@index([statusCode])
