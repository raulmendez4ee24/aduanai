generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// MULTI-TENANT
// ============================================

enum Plan {
  PILOT
  STARTER
  PROFESSIONAL
  ENTERPRISE
  CUSTOM
}

enum TenantStatus {
  TRIAL
  PILOT
  ACTIVE
  SUSPENDED
  CHURNED
}

model Tenant {
  id     String       @id @default(cuid())
  name   String
  plan   Plan         @default(STARTER)
  status TenantStatus @default(ACTIVE)
  rfc    String?
  active Boolean      @default(true)

  // Piloto
  pilotStartedAt      DateTime?
  pilotEndsAt         DateTime?
  classificationLimit Int?
  userLimit           Int?
  pilot15DaySentAt    DateTime?
  pilot25DaySentAt    DateTime?
  pilotExpiredSentAt  DateTime?

  // Contrato
  contractStartedAt DateTime?
  contractEndsAt    DateTime?
  monthlyPrice      Float?
  contractModules   String[]

  // Retención
  lastActivityAt DateTime?
  healthScore    Int       @default(50)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  proposals            Proposal[]
  users                User[]
  classifications      Classification[]
  quotes               Quote[]
  copilotMessages      CopilotMessage[]
  alerts               Alert[]
  auditLogs            AuditLog[]
  operations           Operation[]
  temporaryImports     TemporaryImport[]
  discharges           Discharge[]
  annex24Reports       Annex24Report[]
  annex30Accounts      Annex30Account[]
  taxCredits           TaxCredit[]
  creditUsages         CreditUsage[]
  guarantees           Guarantee[]
  certificationProfile CertificationProfile?
  manifestaciones      ManifestacionValor[]
  coves                COVE[]
  loadPlans            LoadPlan[]
  updateNotifications  UpdateNotification[]
  pedimentos           Pedimento[]
  originAnalyses       OriginAnalysis[]

  @@index([plan])
  @@index([status])
  @@index([pilotEndsAt])
  @@index([contractEndsAt])
  @@map("tenants")
}

// ============================================
// PROPOSALS (cotizaciones comerciales)
// ============================================

enum ProposalStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

model Proposal {
  id             String         @id @default(cuid())
  tenantId       String
  leadId         String?
  plan           Plan
  monthlyPrice   Float
  durationMonths Int            @default(12)
  modules        String[]
  conditions     String?
  supportTier    String?
  status         ProposalStatus @default(DRAFT)
  sentAt         DateTime?
  acceptedAt     DateTime?
  expiresAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([leadId])
  @@index([status])
  @@map("proposals")
}

enum UserRole {
  ADMIN
  USER
  VIEWER
  SUPERADMIN
}

enum UserStatus {
  UNVERIFIED
  VERIFIED
  SUSPENDED
  BANNED
}

model User {
  id                  String     @id @default(cuid())
  email               String     @unique
  password            String
  name                String
  role                UserRole   @default(USER)
  status              UserStatus @default(UNVERIFIED)
  emailVerified       Boolean    @default(false)
  phone               String?
  rfc                 String?
  active              Boolean    @default(true)
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  lastLoginIp         String?
  onboardingCompleted Boolean    @default(false)
  onboardingStep      Int        @default(0)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  classifications   Classification[]
  quotes            Quote[]
  copilotMessages   CopilotMessage[]
  auditLogs         AuditLog[]
  operations        Operation[]
  temporaryImports  TemporaryImport[]
  discharges        Discharge[]
  verificationCodes VerificationCode[]
  pedimentos        Pedimento[]
  originAnalyses    OriginAnalysis[]
  verification      UserVerification?

  @@index([tenantId])
  @@map("users")
}

model VerificationCode {
  id        String   @id @default(cuid())
  userId    String
  code      String
  type      String   @default("email_verify") // "email_verify" | "password_reset"
  expiresAt DateTime
  attempts  Int      @default(0)
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([code])
  @@index([expiresAt])
  @@map("verification_codes")
}

// ============================================
// TIGIE — Fracciones Arancelarias
// ============================================

model Section {
  id          String  @id @default(cuid())
  number      String  @unique // "I", "II", etc.
  title       String
  description String?

  chapters Chapter[]

  @@map("sections")
}

model Chapter {
  id         String  @id @default(cuid())
  number     String  @unique // "01", "02", etc.
  title      String
  legalNotes String? // Notas legales del capítulo

  sectionId String
  section   Section @relation(fields: [sectionId], references: [id])

  headings Heading[]

  @@index([sectionId])
  @@map("chapters")
}

model Heading {
  id          String @id @default(cuid())
  code        String @unique // "0101", "0102"
  description String

  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id])

  subheadings Subheading[]

  @@index([chapterId])
  @@map("headings")
}

model Subheading {
  id          String @id @default(cuid())
  code        String @unique // "010121", "010129"
  description String

  headingId String
  heading   Heading @relation(fields: [headingId], references: [id])

  fractions Fraction[]

  @@index([headingId])
  @@map("subheadings")
}

model Fraction {
  id            String   @id @default(cuid())
  code          String   @unique // "01012101" (8 dígitos sin puntos)
  codeFormatted String // "0101.21.01" (con puntos)
  description   String
  nico          String? // 2 dígitos NICO
  unit          String? // Unidad de medida (Kg, Pza, L, etc.)
  keywords      String[] // Para búsqueda

  // Aranceles
  tariffNMF   Float? // Arancel Nación Más Favorecida (%)
  tariffTMEC  Float? // Preferencial TMEC
  tariffTLCUE Float? // Preferencial TLCUE
  tariffCPTPP Float? // Preferencial CPTPP
  iepsRate    Float? // Tasa IEPS si aplica

  // Regulaciones
  requiresPermit   Boolean  @default(false)
  permitType       String? // "SEMARNAT", "COFEPRIS", etc.
  noms             String[] // NOMs aplicables
  sectoralRegistry Boolean  @default(false)
  sectoralType     String? // Tipo de padrón sectorial

  // Metadata
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subheadingId String
  subheading   Subheading @relation(fields: [subheadingId], references: [id])

  @@index([code])
  @@index([description])
  @@index([keywords])
  @@map("fractions")
}

// ============================================
// BASE DE CONOCIMIENTO
// ============================================

enum KnowledgeType {
  CASO_CLASIFICACION
  CRITERIO_SAT
  RESOLUCION_SCJN
  NOTA_EXPLICATIVA_OMA
  NOTA_LEGAL
  REGLA_SECTOR
  ERROR_COMUN
  PRECEDENTE
  CONSULTA_SAT
}

model ClassificationKnowledge {
  id           String        @id @default(cuid())
  type         KnowledgeType
  fractionCode String?
  chapterCode  String?
  sectionCode  String?
  title        String
  content      String
  source       String
  sourceDate   DateTime?
  keywords     Json
  products     Json?
  priority     Int           @default(5)
  verified     Boolean       @default(false)
  verifiedBy   String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([type])
  @@index([fractionCode])
  @@index([chapterCode])
  @@index([priority])
  @@index([verified])
  @@map("classification_knowledge")
}

// ============================================
// CLASIFICACIONES
// ============================================

model Classification {
  id                  String   @id @default(cuid())
  inputDescription    String
  inputContext        String?
  inputCountryOfOrigin String?
  inputDeclaredValueUSD Float?
  inputUseCase        String?  // uso destinado del producto (texto libre)
  inputSector         String?  // sector industrial (automotive, aeronautic, medical, etc.)
  inputImporterType   String?  // "IMMEX" | "DEFINITIVO" | "PERSONA_FISICA"
  useBasedAnalysis    Json?    // análisis comparativo material vs uso si aplica
  fractionCode        String
  fractionDescription String?
  confidence          Float
  griApplied          String[]
  alternatives        String? // JSON
  legalBasis          Json? // GRI aplicadas, notas legales, partidas descartadas
  fullResponse        String? // JSON completo de la IA
  feedback            String? // "correct", "incorrect", "partial"
  feedbackNote        String?

  // Trazabilidad regulatoria
  tigieVersion        String?  // Versión TIGIE consultada
  ligieVersion        String?  // Versión LIGIE consultada
  consultHash         String?  // SHA-256 del prompt + respuesta para verificación pública
  consultedAt         DateTime?

  // Alertas generadas durante la clasificación (cuotas comp, NOMs, automotive, etc.)
  alertsJson          Json?

  // SOD workflow — clasificador crea, validador aprueba
  // status: "approved" (default, legacy) | "pending_approval" | "rejected"
  status         String    @default("approved")
  approvedAt     DateTime?
  approvedById   String?

  isDemoData          Boolean  @default(false)
  createdAt           DateTime @default(now())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  userId   String
  user     User   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([fractionCode])
  @@index([createdAt])
  @@index([isDemoData])
  @@index([consultHash])
  @@index([tenantId, status])
  @@map("classifications")
}

// ============================================
// COTIZACIONES
// ============================================

model Quote {
  id           String   @id @default(cuid())
  fractionCode String   // legacy / convenience — primer item para queries simples
  customsValue Float    // legacy — total USD del primer item
  origin       String
  incoterm     String   @default("CIF")
  currency     String   @default("USD")
  result       String // JSON con el desglose completo

  // Metadata operación
  name        String?
  client      String?
  destination String?

  // Tipo de cambio aplicado
  exchangeRate     Float?
  exchangeRateDate DateTime?

  // Costos de despacho aduanero (NO incluidos en totalLandedCost de partidas)
  honorariosAgente Float? @default(0)
  prevalidacion    Float? @default(321)
  almacenaje       Float? @default(0)
  estiba           Float? @default(0)
  fleteInterno     Float? @default(0)
  otrosGastos      Json? // [{ label: string, amount: number }]

  // Totales del Quote completo (suma de items + despacho)
  totalLandedCost Float? // Solo contribuciones (suma de items.totalCost)
  totalDispatch   Float? // Suma de despacho aduanero
  totalAll        Float? // landed + despacho

  // SOD workflow — cotizador crea, validador aprueba
  status         String    @default("approved")
  approvedAt     DateTime?
  approvedById   String?

  isDemoData Boolean  @default(false)
  createdAt  DateTime @default(now())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  userId   String
  user     User   @relation(fields: [userId], references: [id])

  items QuoteItem[]

  @@index([tenantId])
  @@index([createdAt])
  @@index([isDemoData])
  @@index([tenantId, status])
  @@map("quotes")
}

model QuoteItem {
  id      String @id @default(cuid())
  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  numeroPartida   Int
  fractionCode    String
  description     String?
  countryOfOrigin String?

  quantity        Float
  unit            String?
  unitValueUSD    Float
  totalValueUSD   Float
  freightUSD      Float  @default(0)
  insuranceUSD    Float  @default(0)
  customsValueUSD Float
  customsValueMXN Float

  igiRate            Float
  dtaRate            Float @default(0.8)
  ivaRate            Float @default(16)
  iepsRate           Float @default(0)
  countervailingRate Float @default(0)

  igi            Float
  dta            Float
  ieps           Float @default(0)
  countervailing Float @default(0)
  iva            Float
  totalDuties    Float
  totalCost      Float

  hasAntidumping    Boolean @default(false)
  antidumpingDecree String?

  createdAt DateTime @default(now())

  @@index([quoteId])
  @@index([fractionCode])
  @@map("quote_items")
}

// ============================================
// PEDIMENTO — Pre-validador formal (Anexo 22)
// ============================================

enum PedimentoStatus {
  DRAFT
  VALIDATING
  WITH_ERRORS
  VALIDATED
  TRANSMITTED
}

model Pedimento {
  id String @id @default(cuid())

  // Datos del pedimento (Anexo 22)
  numero         String? // Número de pedimento
  clave          String // A1, IN, RT, R1, etc.
  aduana         String // Aduana de despacho
  patenteAduanal String
  rfcImportador  String
  curp           String?

  // Datos generales
  tipoOperacion   String // IMP, EXP
  regimen         String // Definitivo, temporal, etc.
  destino         String?
  origen          String?
  pesoBruto       Float
  pesoNeto        Float
  bultos          Int

  // Valores
  valorAduana    Float
  valorComercial Float
  valorDolares   Float
  tipoCambio     Float

  // Incoterm y transporte
  incoterm        String
  transporte      String // Marítimo, aéreo, terrestre
  medioTransporte String?

  // Documentos relacionados
  factura String?
  cove    String?
  bl      String?

  // Validación
  errors   Json?  // [{ partida?: number, field: string, severity: 'error'|'warning'|'info', message: string, rule: string }]
  warnings Json?
  aiNotes  Json? // Notas IA (inconsistencias detectadas por LLM)
  status   PedimentoStatus @default(DRAFT)

  isDemoData Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  userId   String
  user     User   @relation(fields: [userId], references: [id])

  partidas PedimentoPartida[]

  @@index([tenantId])
  @@index([status])
  @@index([numero])
  @@index([rfcImportador])
  @@map("pedimentos")
}

model PedimentoPartida {
  id          String    @id @default(cuid())
  pedimentoId String
  pedimento   Pedimento @relation(fields: [pedimentoId], references: [id], onDelete: Cascade)

  numeroPartida   Int
  fraccion        String // 8 dígitos sin puntos
  descripcion     String
  cantidad        Float
  unidadMedida    String
  unidadMedidaCom String? // unidad comercial

  valorUnitario Float
  valorAduana   Float

  pais         String // país origen
  paisVendedor String?

  // Contribuciones por partida
  igi  Float?
  dta  Float?
  iva  Float?
  ieps Float?

  // Permisos / identificadores Anexo 22
  permisos        Json? // RRNA, NOMs, etc. → [{ tipo, codigo, autoridad }]
  identificadores Json? // Identificadores específicos → [{ codigo, complemento1?, complemento2? }]

  // Vinculación con vendedor (Art. 71 Ley Aduanera)
  vinculacion     Boolean @default(false)
  vinculacionDesc String?

  createdAt DateTime @default(now())

  @@index([pedimentoId])
  @@index([fraccion])
  @@map("pedimento_partidas")
}

model ExchangeRate {
  id        String   @id @default(cuid())
  date      DateTime @unique
  rate      Float
  source    String   @default("synthetic") // "banxico" | "manual" | "synthetic"
  createdAt DateTime @default(now())

  @@index([date])
  @@map("exchange_rates")
}

// ============================================
// COPILOT
// ============================================

model CopilotMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String // "user" | "assistant"
  content        String
  createdAt      DateTime @default(now())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  userId   String
  user     User   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([conversationId])
  @@index([createdAt])
  @@map("copilot_messages")
}

// ============================================
// ALERTAS
// ============================================

enum AlertChannel {
  WHATSAPP
  EMAIL
  IN_APP
}

model Alert {
  id         String       @id @default(cuid())
  channel    AlertChannel @default(IN_APP)
  type       String // "tariff_change" | "new_regulation" | "weekly_summary" | "credit_expiring" | "guarantee_expiring" | "import_expiring" | "antidumping_new" | "subvaluation_risk" | "watch"
  title      String
  content    String
  read       Boolean      @default(false)
  sentAt     DateTime?
  isDemoData Boolean      @default(false)
  createdAt  DateTime     @default(now())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  // Fracciones monitoreadas (opcional)
  fractionCodes String[]

  // Inteligencia y accionabilidad
  severity            String   @default("medium") // "critical" | "high" | "medium" | "low"
  affectedFraction    String?  // fracción específica (8 dígitos sin puntos)
  affectedOperations  String[] // IDs de TemporaryImport / Operation / TaxCredit / Guarantee impactados
  estimatedImpactMXN  Float?   // monto estimado en MXN (positivo = ahorro, negativo = costo)
  impactType          String?  // "savings" | "cost" | "risk"
  actionRequired      String?  // descripción corta de la acción requerida
  suggestedAction     Json?    // { type, label, payload? } estructurado

  // Vencimiento y workflow
  dueDate     DateTime?
  daysToDue   Int?      // calculado al insertar; se recalcula con cron si es necesario
  acknowledged Boolean  @default(false)
  acknowledgedAt DateTime?
  snoozedUntil DateTime?
  ignored     Boolean   @default(false)
  resolvedAt  DateTime?

  // Deduplicación: hash determinista de (tenantId|type|fingerprint)
  fingerprint String?

  updatedAt DateTime @default(now()) @updatedAt

  @@index([tenantId])
  @@index([createdAt])
  @@index([isDemoData])
  @@index([severity])
  @@index([affectedFraction])
  @@index([dueDate])
  @@index([fingerprint])
  @@unique([tenantId, fingerprint])
  @@map("alerts")
}

// ============================================
// AUDITORÍA — Trazabilidad obligatoria en comex
// ============================================

model AuditLog {
  id        String   @id @default(cuid())
  action    String // CREATE, UPDATE, DELETE, LOGIN, LOGOUT, FAILED_LOGIN, EXPORT, etc.
  entity    String // Classification, Quote, Pedimento, User, Tenant, etc.
  entityId  String?
  details   String? // legacy
  before    Json? // estado antes
  after     Json? // estado después
  diff      Json? // qué cambió (shallow diff)
  ipAddress String?
  userAgent String?
  endpoint  String?
  method    String?
  metadata  Json? // datos extra
  hash      String   @default("") // SHA-256 hash del registro (chain)
  prevHash  String? // hash del registro previo del mismo tenant
  createdAt DateTime @default(now())

  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  userId   String?
  user     User?   @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt])
  @@index([entity, entityId])
  @@index([userId])
  @@index([action])
  @@index([hash])
  @@map("audit_logs")
}

// ============================================
// EXPEDIENTE ELECTRÓNICO
// ============================================

enum OperationStatus {
  DRAFT
  IN_PROGRESS
  COMPLETE
  ARCHIVED
}

enum OperationType {
  IMPORT
  EXPORT
  TRANSIT
}

model Operation {
  id            String          @id @default(cuid())
  reference     String // Número de referencia / pedimento
  type          OperationType   @default(IMPORT)
  status        OperationStatus @default(DRAFT)
  fractionCode  String?
  description   String?
  origin        String?
  destination   String?
  customsValue  Float?
  currency      String?         @default("USD")
  customsBroker String? // Agente aduanal
  completeness  Float           @default(0) // % de documentos completos
  notes         String?
  operationDate DateTime?
  isDemoData    Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  userId   String
  user     User   @relation(fields: [userId], references: [id])

  documents Document[]

  @@index([tenantId])
  @@index([reference])
  @@index([status])
  @@index([createdAt])
  @@index([isDemoData])
  @@map("operations")
}

enum DocumentStatus {
  PENDING
  UPLOADED
  VERIFIED
  EXPIRED
  REJECTED
}

model Document {
  id         String         @id @default(cuid())
  tenantId   String?        // null para legacy; nuevo upload siempre lleva tenantId
  name       String
  type       String // tipo declarado por el usuario o slot
  status     DocumentStatus @default(PENDING)
  required   Boolean        @default(true)
  fileName   String?
  fileSize   Int?
  mimeType   String?
  filePath   String?
  fileUrl    String?  // URL pública o data: URI corta
  fileHash   String?  // SHA-256 del contenido — para cache de extracción

  // Extracción IA
  docType       String? // tipo detectado por IA (factura, pedimento, bl, etc.)
  confidence    Float?  // 0-100
  extractedData Json?   // datos estructurados por tipo
  rawText       String? // texto OCR/extraído (truncado)
  aiErrors      Json?
  processedAt   DateTime?

  expiresAt  DateTime?
  verifiedAt DateTime?
  verifiedBy String?
  notes      String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  operationId String?
  operation   Operation? @relation(fields: [operationId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([operationId])
  @@index([type])
  @@index([docType])
  @@index([status])
  @@index([expiresAt])
  @@index([fileHash])
  @@map("documents")
}

// ============================================
// INVENTARIO IMMEX — Control Anexo 24/30
// ============================================

enum ImportStatus {
  ACTIVE
  PARTIALLY_DISCHARGED
  FULLY_DISCHARGED
  EXPIRED
  REGULARIZED
}

model TemporaryImport {
  id                 String       @id @default(cuid())
  pedimento          String // Número de pedimento (ej: "24 47 3461 4000123")
  fractionCode       String // Fracción arancelaria 8 dígitos
  description        String // Descripción de la mercancía
  quantity           Float // Cantidad importada
  unit               String // Unidad de medida (Kg, Pza, L, etc.)
  customsValue       Float // Valor en aduana USD
  valueMXN           Float? // Valor en MXN
  supplier           String? // Proveedor extranjero
  originCountry      String? // País de origen
  entryDate          DateTime // Fecha de entrada (pedimento)
  expirationDate     DateTime // Fecha de vencimiento (18 o 36 meses)
  expirationMonths   Int          @default(18) // 18 general, 36 con certificación
  quantityDischarged Float        @default(0) // Cantidad descargada acumulada
  status             ImportStatus @default(ACTIVE)
  notes              String?
  isDemoData         Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  userId   String
  user     User   @relation(fields: [userId], references: [id])

  discharges Discharge[]

  @@index([tenantId])
  @@index([fractionCode])
  @@index([pedimento])
  @@index([status])
  @@index([expirationDate])
  @@index([entryDate])
  @@index([isDemoData])
  @@map("temporary_imports")
}

enum DischargeType {
  RETURN_EXPORT // Retorno al extranjero
  DOMESTIC_SALE // Venta nacional (cambio a definitiva)
  REGIME_CHANGE // Cambio de régimen
  WASTE // Desperdicio
  SCRAP // Merma
  DESTRUCTION // Destrucción
  DONATION // Donación
  TRANSFER // Transferencia virtual entre IMMEX
}

model Discharge {
  id                 String        @id @default(cuid())
  type               DischargeType
  pedimento          String? // Pedimento de descargo/retorno
  quantity           Float // Cantidad descargada
