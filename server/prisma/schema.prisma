// ============================================
// BOM — Productos terminados y materia prima IMMEX
// ============================================

model Product {
  id           String   @id @default(cuid())
  tenantId     String
  productCode  String   // SKU del cliente
  description  String
  fractionCode String?  // Fracción arancelaria si aplica (8 dígitos sin puntos)
  unit         String   // Pza, Kg, m, etc.
  isFinished   Boolean  @default(false) // false = materia prima, true = producto terminado
  active       Boolean  @default(true)
  isDemoData   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Si es producto terminado: componentes que lo conforman
  components ProductComponent[] @relation("ProductBOM")
  // Si es materia prima: en qué productos terminados se usa
  usedIn     ProductComponent[] @relation("ComponentOfBOM")
  assemblies Assembly[]

  @@unique([tenantId, productCode])
  @@index([tenantId])
  @@index([isFinished])
  @@index([fractionCode])
  @@index([isDemoData])
  @@map("products")
}

model ProductComponent {
  id           String   @id @default(cuid())
  productId    String   // Producto terminado
  product      Product  @relation("ProductBOM", fields: [productId], references: [id], onDelete: Cascade)
  componentId  String   // Materia prima / sub-ensamble
  component    Product  @relation("ComponentOfBOM", fields: [componentId], references: [id])
  quantity     Float    // Unidades de componente requeridas por 1 unidad de producto terminado
  unit         String
  scrapPercent Float    @default(0) // Merma esperada (%)
  notes        String?
  createdAt    DateTime @default(now())

  @@unique([productId, componentId])
  @@index([productId])
  @@index([componentId])
  @@map("product_components")
}

model Assembly {
  id           String   @id @default(cuid())
  tenantId     String
  productId    String   // Producto terminado ensamblado
  product      Product  @relation(fields: [productId], references: [id])
  quantity     Float    // Cantidad ensamblada
  assemblyDate DateTime
  reference    String?  // Orden de producción / referencia interna
  notes        String?
  isDemoData   Boolean  @default(false)
  createdAt    DateTime @default(now())

  consumptions AssemblyConsumption[]

  @@index([tenantId])
  @@index([productId])
  @@index([assemblyDate])
  @@index([isDemoData])
  @@map("assemblies")
}

model AssemblyConsumption {
  id                String   @id @default(cuid())
  assemblyId        String
  assembly          Assembly @relation(fields: [assemblyId], references: [id], onDelete: Cascade)
  componentId       String   // Producto materia prima consumido
  componentCode     String   // SKU snapshot
  fractionCode      String?  // Fracción snapshot
  quantityRequired  Float    // Por BOM, sin merma
  quantityWithScrap Float    // Real consumido = required × (1 + scrapPercent/100)
  unit              String
  // Trazabilidad: IDs de TemporaryImport descontados FIFO
  importIds         String[]
  createdAt         DateTime @default(now())

  @@index([assemblyId])
  @@index([componentId])
  @@map("assembly_consumptions")
}

// ============================================
// CUOTAS COMPENSATORIAS (antidumping)
// ============================================

model AntidumpingDuty {
  id String @id @default(cuid())

  // Identificación de la resolución
  resolutionType   String  @default("definitiva") // "definitiva" | "provisional" | "preliminar"
  resolutionNumber String? // "RES-29/2024"
  expedienteUPCI   String? // "UPCI-AD-23-2023"

  // Producto y origen
  fractionCode    String
  countryOfOrigin String  // ISO-2 normalizado
  productDesc     String? // descripción del producto cubierto

  // Productor específico (si la cuota es para un productor)
  specificProducer String?

  // Cuota — soporta % o específica
  rateType String @default("percentage") // "percentage" | "specific_USD_kg" | "specific_USD_unit"
  rate     Float  // valor numérico
  rateUnit String @default("%")          // "%", "USD/kg", "USD/par", "USD/pieza"

  // Vigencia
  publishDateDOF DateTime?
  publishDate    DateTime?
  effectiveDate  DateTime?
  expiryDate     DateTime?

  // Estado de la resolución
  status            String @default("vigente") // "vigente" | "suspendida" | "revocada" | "en_revision"
  investigationType String? // "elusion" | "examen_vigencia" | "revision" | "nueva"

  // Documentación
  decree  String? // legacy — mantenido para compat
  dofUrl  String?
  notes   String?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fractionCode, countryOfOrigin, status])
  @@index([fractionCode])
  @@index([countryOfOrigin])
  @@index([active])
  @@index([effectiveDate, expiryDate])
  @@index([resolutionNumber])
  @@map("antidumping_duties")
}

