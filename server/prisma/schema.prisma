}

// ============================================
// TIGIE AUTO-UPDATE AGENT
// ============================================

enum UpdateStatus {
  DETECTED
  ANALYZED
  APPROVED
  APPLIED
  REJECTED
}

model TIGIEUpdate {
  id                  String       @id @default(cuid())
  source              String // "DOF", "SAT", "SE", "manual"
  decree              String? // Nombre/referencia del decreto
  publishDate         DateTime
  effectiveDate       DateTime
  summary             String
  fractionsCreated    Int          @default(0)
  fractionsModified   Int          @default(0)
  fractionsSuppressed Int          @default(0)
  nomsUpdated         Int          @default(0)
  changes             Json // Array de cambios individuales
  status              UpdateStatus @default(DETECTED)
  appliedAt           DateTime?
  appliedBy           String?
  usersNotified       Int          @default(0)
  createdAt           DateTime     @default(now())

  notifications UpdateNotification[]

  @@index([status])
  @@index([publishDate])
  @@index([createdAt])
  @@map("tigie_updates")
}

model UpdateNotification {
  id           String    @id @default(cuid())
  fractionCode String
  changeType   String // "arancel_change", "fraction_created", "fraction_suppressed", "nom_change"
  oldValue     String?
  newValue     String?
  message      String
  channel      String // "app", "whatsapp", "email"
  sent         Boolean   @default(false)
  sentAt       DateTime?
  read         Boolean   @default(false)
  createdAt    DateTime  @default(now())

  updateId String
  update   TIGIEUpdate @relation(fields: [updateId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  userId String

  @@index([tenantId])
  @@index([userId])
  @@index([updateId])
  @@index([read])
  @@index([fractionCode])
  @@map("update_notifications")
}

// ============================================
// DEMO ACCOUNTS
// ============================================

model DemoAccount {
  id        String   @id @default(cuid())
  leadId    String
  tenantId  String
  userId    String
  email     String
  password  String // plaintext temporary password (shown to admin)
  expiresAt DateTime
  active    Boolean  @default(true)
  products  String[] // pre-loaded product descriptions
  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([expiresAt])
  @@map("demo_accounts")
}

// ============================================
// LEADS (público, sin auth)
// ============================================

model Lead {
  id      String  @id @default(cuid())
  name    String
  company String?
  email   String
  phone   String
  message String?
  source  String  @default("landing")
  status  String  @default("new") // new, contacted, demo_scheduled, demo_done, pilot, negotiating, converted, discarded

  // Nivel 2 — calificación
  rfc             String?
  industry        String? // giro de la empresa
  monthlyOps      String? // operaciones mensuales aprox
  hasIMMEX        Boolean?
  currentSoftware String?
  problems        String[] // array de problemas seleccionados
  referralSource  String? // cómo nos encontró

  // Scoring
  score          Int     @default(0)
  scoreBreakdown String? // JSON con detalle del score

  createdAt DateTime @default(now())
