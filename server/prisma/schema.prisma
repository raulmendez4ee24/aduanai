  latencyMs   Int
  confidence  Float

  consultHash String @unique

  helpful      Boolean?
  feedbackNote String?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([createdAt])
  @@map("copilot_consults")
}

// ============================================
